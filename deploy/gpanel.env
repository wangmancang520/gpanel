# GPanel settings, read by gpanel.service. Installed to /etc/gpanel/gpanel.env.
# After editing: sudo systemctl restart gpanel  (this also stops running game servers)

# Listen address. Keep 127.0.0.1 behind a reverse proxy (Caddy/Nginx with HTTPS);
# use 0.0.0.0:24444 to expose it directly.
GPANEL_ADDR=127.0.0.1:24444

# Download Java from a mirror, falling back to the official source when the
# mirror doesn't have a build yet. For mainland China, e.g. Tsinghua TUNA:
#GPANEL_JAVA_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/Adoptium/{major}/{image}/{arch}/{os}/{file}

# HTTPS is configured in the panel (Security page). If a certificate or
# "force HTTPS" ever locks you out, set this, restart, and fix it over HTTP:
#GPANEL_DISABLE_TLS=1
